---
import { Home } from "../components/Home";
import { InteractiveChat } from "../components/InteractiveChat";
import { Navigation } from "../components/Navigation";
import PortfolioSections from "../components/PortfolioSections";
import { ThemeProvider } from "../components/ThemeProvider";
import { VectorBackground } from "../components/VectorBackground";
import { Toaster } from "../components/ui/sonner";
import Layout from "../layouts/Layout.astro";
import { loadAll } from "../lib/data";
import "../styles/globals.css";

const { config, resume } = loadAll();
---

<Layout config={config} resume={resume}>
  <ThemeProvider
    client:only="react"
    defaultTheme="light"
    storageKey="portfolio-theme"
  >
    <Navigation client:only="react" config={config} basics={resume.basics} />
    <div class="relative flex flex-col md:flex-row min-h-screen">
      <div class="main-content-wrapper flex-1 min-w-0">
        <Home
          client:load
          basics={resume.basics}
          recommendedQuestions={config.agent?.["recommended-questions"]}
        />
        <PortfolioSections client:visible resume={resume} config={config} />
      </div>
      <InteractiveChat client:only="react" config={config} />
    </div>
    <VectorBackground client:only="react" />
    <Toaster client:only="react" />
  </ThemeProvider>
</Layout>
