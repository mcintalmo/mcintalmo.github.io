---
import { getCollection } from "astro:content";
import { InteractiveChat } from "../../components/InteractiveChat";
import { Home } from "../../components/Home";
import PortfolioSections from "../../components/PortfolioSections";
import Layout from "../../layouts/Layout.astro";
import { loadAll } from "../../lib/data";
import "../../styles/globals.css";

export async function getStaticPaths() {
  const tailoredEntries = await getCollection("tailored");
  return tailoredEntries.map((entry) => ({
    params: { company: entry.id.replace(/\.ya?ml$/, "") },
    props: { tailoredResume: entry.data },
  }));
}

const { tailoredResume } = Astro.props;
const { config } = loadAll();
---

<Layout config={config} resume={tailoredResume}>
  <div class="flex flex-col md:flex-row min-h-screen">
    <div class="flex-1 min-w-0 transition-all duration-300">
      <Home
        client:load
        basics={tailoredResume.basics}
        recommendedQuestions={config.agent?.["recommended-questions"]}
      />
      <PortfolioSections
        client:visible
        resume={tailoredResume}
        config={config}
      />
    </div>
    <InteractiveChat client:only="react" config={config} />
  </div>
</Layout>
